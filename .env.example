# Runtime
YARD_ENVIRONMENT=development
YARD_LOG_LEVEL=INFO

# Backend dependencies (populated by the runnable backend slice)
YARD_DATABASE_URL=postgresql+asyncpg://yard:yard@localhost:5432/yard
YARD_REDIS_URL=redis://localhost:6379/0

# External integrations are intentionally unset until configured.
YARD_APPLE_AUDIENCE=
YARD_AWS_REGION=us-east-1
YARD_S3_BUCKET=
YARD_SES_FROM_EMAIL=

