# Runtime
YARD_ENVIRONMENT=development
YARD_LOG_LEVEL=INFO

# Backend dependencies (populated by the runnable backend slice)
YARD_DATABASE_URL=postgresql+asyncpg://yard:yard@localhost:5432/yard
YARD_REDIS_URL=redis://localhost:6379/0
YARD_ACCESS_TOKEN_SECRET=development-only-access-secret-change-me
YARD_VERIFICATION_PEPPER=development-only-verification-pepper-change-me

# Local S3-compatible object storage
YARD_S3_ACCESS_KEY=yard
YARD_S3_SECRET_KEY=yard-development-only
YARD_S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
YARD_S3_INTERNAL_ENDPOINT=http://localhost:9000
YARD_S3_BUCKET=yard
YARD_ASSET_BASE_URL=http://127.0.0.1:9000/yard

# External integrations are intentionally unset until configured.
YARD_APPLE_AUDIENCE=
YARD_AWS_REGION=us-east-1
YARD_S3_BUCKET=
YARD_SES_FROM_EMAIL=


# Apple Push Notification service
YARD_APNS_TEAM_ID=
YARD_APNS_KEY_ID=
YARD_APNS_PRIVATE_KEY=
YARD_APNS_BUNDLE_ID=com.santinomarial.yard
YARD_APNS_SANDBOX=true

# Edge/security controls
YARD_RATE_LIMIT_ENABLED=true
YARD_MAX_REQUEST_BYTES=1048576
YARD_TRUSTED_PROXY_IPS=[]
